{
  "python.terminal.activateEnvironment": true,
  "editor.formatOnSave": true,
  "editor.rulers": [
    100
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "venv": true,
    "data": true,
    "checkpoints_16": true,
    "frontend/node_modules": true,
    "frontend/.next": true,
    "frontend/public/ort": true,
    "frontend/tsconfig.tsbuildinfo": true,
    "frontend/next-env.d.ts": true
  },
  "jupyter.notebookFileRoot": "${workspaceFolder}"
}